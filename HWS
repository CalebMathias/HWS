# ----------------------- Model Definitions -----------------------

class LightweightActionRecognizer(nn.Module):
    def __init__(self, input_size=1056, num_classes=5):  # Changed from 66 to 1056
        super(LightweightActionRecognizer, self).__init__()
        self.fc1 = nn.Linear(input_size, 64)
        self.fc2 = nn.Linear(64, num_classes)
        self.relu = nn.ReLU()

    def forward(self, x):
        x = self.relu(self.fc1(x))
        return self.fc2(x)

class NavigationController:
    def __init__(self, hws, grid_size=20, obstacle_threshold=0.5):
        self.hws = hws
        self.grid_size = grid_size
        self.obstacle_threshold = obstacle_threshold

    def generate_occupancy_grid(self, frame, obstacle_boxes):
        h, w = frame.shape[:2]
        grid_h, grid_w = h // self.grid_size, w // self.grid_size
        occupancy_grid = np.zeros((grid_h, grid_w), dtype=int)
        for box in obstacle_boxes:
            x1, y1, x2, y2 = box
            grid_x1 = int(x1 / self.grid_size)
            grid_y1 = int(y1 / self.grid_size)
            grid_x2 = int(x2 / self.grid_size)
            grid_y2 = int(y2 / self.grid_size)
            for gi in range(grid_y1, min(grid_y2 + 1, grid_h)):
                for gj in range(grid_x1, min(grid_x2 + 1, grid_w)):
                    occupancy_grid[gi, gj] = 1
        return occupancy_grid

    def heuristic(self, a, b):
        return abs(a[0] - b[0]) + abs(a[1] - b[1])

    def astar(self, grid, start, goal):
        neighbors = [(0, 1), (1, 0), (0, -1), (-1, 0)]
        close_set = set()
        came_from = {}
        gscore = {start: 0}
        fscore = {start: self.heuristic(start, goal)}
        oheap = [(fscore[start], start)]
        while oheap:
            current = oheap.pop(0)[1]
            if current == goal:
                path = []
                while current in came_from:
                    path.append(current)
                    current = came_from[current]
                return path[::-1]
            close_set.add(current)
            for i, j in neighbors:
                neighbor = (current[0] + i, current[1] + j)
                tentative_g_score = gscore[current] + 1
                if 0 <= neighbor[0] < grid.shape[0] and 0 <= neighbor[1] < grid.shape[1]:
                    if grid[neighbor[0]][neighbor[1]] == 1 or neighbor in close_set:
                        continue
                    if tentative_g_score < gscore.get(neighbor, float('inf')):
                        came_from[neighbor] = current
                        gscore[neighbor] = tentative_g_score
                        fscore[neighbor] = tentative_g_score + self.heuristic(neighbor, goal)
                        oheap.append((fscore[neighbor], neighbor))
                        oheap.sort()
        return []

    def plan_path(self, frame, start_pixel, goal_pixel, obstacle_boxes):
        start = (start_pixel[1] // self.grid_size, start_pixel[0] // self.grid_size)
        goal = (goal_pixel[1] // self.grid_size, goal_pixel[0] // self.grid_size)
        occupancy_grid = self.generate_occupancy_grid(frame, obstacle_boxes)
        path = self.astar(occupancy_grid, start, goal)
        return [(col * self.grid_size + self.grid_size // 2, row * self.grid_size + self.grid_size // 2) for row, col in path]

# ----------------------- HWS-Lite Class -----------------------

class HWSLite:
    def __init__(self, video_source=0):
        self.model = YOLO("yolov8n.pt")  # Lightweight YOLOv8 nano
        self.tracker = DeepSort(max_age=15)
        self.cap = cv2.VideoCapture(video_source)
        if not self.cap.isOpened():
            raise Exception(f"Failed to open video source: {video_source}")
        self.frame_width = int(self.cap.get(cv2.CAP_PROP_FRAME_WIDTH))
        self.frame_height = int(self.cap.get(cv2.CAP_PROP_FRAME_HEIGHT))
        self.speech_queue = queue.Queue()
        self.tracks_lock = threading.Lock()
        self.current_tracks = []  # Added to store current tracks

        self.tts = pyttsx3.init()
        self.tts.setProperty("rate", 60)
        pygame.mixer.init()
        self.speech_thread = threading.Thread(target=self._speech_loop, daemon=True)
        self.speech_thread.start()

        self.audio_stream = sd.InputStream(callback=self.audio_callback, samplerate=16000, channels=1)
        self.audio_buffer = []
        self.forensic_audio_classes = ["gunshot", "scream", "glass breaking", "explosion"]
        self.latest_audio_scores = np.zeros(len(self.forensic_audio_classes))
        self.audio_stream.start()

        self.action_model = LightweightActionRecognizer(input_size=1056, num_classes=5)  # Changed from 66 to 1056
        self.optimizer = torch.optim.Adam(self.action_model.parameters(), lr=0.001)
        self.class_labels = {0: "person", 2: "car", 39: "bottle", 43: "knife", 56: "chair"}
        self.stationary_objects = {"chair"}
        self.frame_counter = 0
        self.active_tracks = {}
        self.last_spoken = {}
        self.abandoned_objects = set()
        self.pose_sequences = {}
        self.track_actions = {}
        self.navigation_controller = NavigationController(self)
        self.navigation_goal = (self.frame_width // 2, 0)
        self.navigation_thread = threading.Thread(target=self._navigation_loop, daemon=True)
        self.navigation_thread.start()

    def _speech_loop(self):
        while True:
            message = self.speech_queue.get()
            if message is None:
                break
            self.tts.say(message)
            self.tts.runAndWait()
            self.speech_queue.task_done()

    def audio_callback(self, indata, frames, time_info, status):
        self.audio_buffer.extend(indata[:, 0])
        if len(self.audio_buffer) >= 16000:
            audio_data = np.array(self.audio_buffer[:16000], dtype=np.float32)
            self.audio_buffer = self.audio_buffer[16000:]
            # Simplified audio detection (threshold-based)
            energy = np.mean(audio_data ** 2)
            for i, cls in enumerate(self.forensic_audio_classes):
                self.latest_audio_scores[i] = 1.0 if energy > 0.1 else 0.0  # Dummy scoring

    def speak(self, message):
        self.speech_queue.put(message)
        self.last_spoken[message] = datetime.now()

    def get_obstacle_boxes(self):
        with self.tracks_lock:
            return [t.to_tlbr() for t in self.current_tracks if t.is_confirmed()]

    def _navigation_loop(self):
        while self.cap.isOpened():
            frame = self._grab_frame()
            obstacle_boxes = self.get_obstacle_boxes()
            start_pixel = (self.frame_width // 2, self.frame_height - 10)
            path = self.navigation_controller.plan_path(frame, start_pixel, self.navigation_goal, obstacle_boxes)
            if path:
                self.speak(f"Path planned with {len(path)} steps.")
            time.sleep(10)

    def _grab_frame(self):
        ret, frame = self.cap.read()
        return frame if ret else np.zeros((self.frame_height, self.frame_width, 3), dtype=np.uint8)

    def object_detector(self):
        logging.info("🚀 HWS-Lite - Lightweight He Who Sees")
        while self.cap.isOpened():
            try:
                ret, frame = self.cap.read()
                if not ret:
                    break
                current_time = datetime.now().strftime("%H:%M:%S")

                results = self.model(frame, conf=0.3)
                detections = []
                for result in results:
                    if result.boxes is not None:
                        for box in result.boxes:
                            xyxy = box.xyxy[0].cpu().numpy().astype(int)
                            conf = box.conf[0].item()
                            cls_id = int(box.cls[0].item())
                            class_name = self.class_labels.get(cls_id, "unknown")
                            detections.append([xyxy.tolist(), conf, class_name])

                with self.tracks_lock:
                    self.current_tracks = self.tracker.update_tracks(detections, frame=frame)
                
                person_tracks = [t for t in self.current_tracks if t.det_class == "person" and t.is_confirmed()]

                current_track_dict = {track.track_id: track.det_class for track in self.current_tracks if track.is_confirmed()}
                new_ids = set(current_track_dict.keys()) - set(self.active_tracks.keys())
                for new_id in new_ids:
                    det_class = current_track_dict[new_id]
                    self.speak(f"New {det_class} detected with ID {new_id}.")
                    self.active_tracks[new_id] = {"type": det_class, "missing_count": 0}

                missing_ids = set(self.active_tracks.keys()) - set(current_track_dict.keys())
                for missing_id in missing_ids:
                    self.active_tracks[missing_id]["missing_count"] += 1
                    if self.active_tracks[missing_id]["missing_count"] >= 15:
                        det_class = self.active_tracks[missing_id]["type"]
                        self.speak(f"{det_class} with ID {missing_id} is gone.")
                        del self.active_tracks[missing_id]
                        self.pose_sequences.pop(missing_id, None)
                        self.track_actions.pop(missing_id, None)

                for person_track in person_tracks:
                    box = person_track.to_tlbr().astype(int)
                    box = [max(0, box[0]), max(0, box[1]), min(self.frame_width, box[2]), min(self.frame_height, box[3])]
                    if box[2] > box[0] and box[3] > box[1]:
                        # Simplified pose feature extraction (dummy data)
                        pose_features = np.random.rand(33, 2).flatten()
                        self.pose_sequences.setdefault(person_track.track_id, []).append(pose_features)
                        if len(self.pose_sequences[person_track.track_id]) >= 16:
                            sequence = np.array(self.pose_sequences[person_track.track_id][-16:]).flatten()
                            sequence_tensor = torch.tensor(sequence, dtype=torch.float32).unsqueeze(0)
                            with torch.no_grad():
                                output = self.action_model(sequence_tensor)
                                action_id = torch.argmax(output, dim=1).item()
                                action_label = ["walking", "running", "sitting", "standing", "fighting"][action_id]
                                self.track_actions[person_track.track_id] = action_label
                                self.speak(f"Person ID {person_track.track_id} is {action_label}.")

                object_tracks = [t for t in self.current_tracks if t.det_class != "person" and t.is_confirmed()]
                current_track_ids = set(t.track_id for t in self.current_tracks)
                for obj_track in object_tracks:
                    if obj_track.det_class in self.stationary_objects:
                        continue
                    track_id = obj_track.track_id
                    if track_id not in self.abandoned_objects and all(
                        np.linalg.norm(obj_track.to_tlbr() - p.to_tlbr()) > 100 for p in person_tracks
                    ):
                        self.abandoned_objects.add(track_id)
                        self.speak(f"{obj_track.det_class} ID {track_id} appears abandoned.")

                self.abandoned_objects.intersection_update(current_track_ids)
                self.frame_counter += 1
                cv2.imshow("HWS-Lite Output", frame)
                if cv2.waitKey(1) & 0xFF == ord('q'):
                    break

            except Exception as e:
                logging.error(f"Error: {e}")

        self._cleanup()

    def _cleanup(self):
        if self.cap.isOpened():
            self.cap.release()
        cv2.destroyAllWindows()
        self.speech_queue.put(None)
        self.audio_stream.stop()
        pygame.mixer.quit()

